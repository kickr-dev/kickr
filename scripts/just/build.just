# Code generated by kickr; DO NOT EDIT.

# run unit tests.
test:
  @go test ./... -count 1 -timeout=30s

# run unit tests with the race detector.
test-race:
  @CGO_ENABLED=1 go test ./... -race -timeout=30s

# run unit tests with coverage.
test-cover:
  @go test ./... -v -coverpkg="./..." -covermode="count" -timeout=30s

# build the kickr binary.
build:
  @CGO_ENABLED=0 go build \
    -ldflags "\
      -X 'github.com/kickr-dev/kickr/internal/build.branch=$(git rev-parse --abbrev-ref HEAD)' \
      -X 'github.com/kickr-dev/kickr/internal/build.commit=$(git rev-parse HEAD)' \
      -X 'github.com/kickr-dev/kickr/internal/build.date=$(TZ=UTC date '+%Y-%m-%dT%TZ')' \
      -X 'github.com/kickr-dev/kickr/internal/build.version=${APP_VERSION:-v0.0.0}' \
    " \
    -o kickr ./cmd/kickr

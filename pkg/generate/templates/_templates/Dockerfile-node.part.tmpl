{{- define "node" }}

{{- $specifics := get .Languages "node" }}
{{- $manager := cutAfter $specifics.PackageManager "@" }}

ARG BASE_IMAGE=nginx:1.31.8-alpine3.24@sha256:1ef7ca94d7879df82421428ce13bd1eaa412404953859cf7a5b6512c25e67a60

#############################
#        STAGE BUILD        #
#############################
FROM node:26.13.0-alpine3.23@sha256:e6c03d42b46af3b1e98207e59f06a43cfe5efd3ec4b4d3d9802bddf04f833374 AS build

ARG APP_VERSION=v0.0.0

WORKDIR /app

COPY . .

RUN {{ $manager }} {{ eq $manager "npm" | ternary "ci" "install --frozen-lockfile" }} && \
    {{ $manager }} run build

#############################
#         STAGE RUN         #
#############################
FROM ${BASE_IMAGE}
ARG BASE_IMAGE
LABEL org.opencontainers.image.base.name="${BASE_IMAGE}"

WORKDIR /app

COPY --from=build /app/dist /usr/share/nginx/html

RUN sed -i 's#listen 80;#listen {{ .Parent.Config.Docker.Port | default 3000 }};#' /etc/nginx/conf.d/default.conf

EXPOSE {{ .Parent.Config.Docker.Port | default 3000 }}
{{- end }}

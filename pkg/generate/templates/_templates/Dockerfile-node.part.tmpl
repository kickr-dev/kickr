{{- define "node" }}

{{- $specifics := get .Languages "node" }}
{{- $manager := cutAfter $specifics.PackageManager "@" }}

ARG BASE_IMAGE=nginx:1.31.10-alpine3.24@sha256:7fc0fb4af7bf006aeb31aea88069976060f8f0a0a86b667126742cc17f4e31ae

#############################
#        STAGE BUILD        #
#############################
FROM node:26.13.1-alpine3.23@sha256:39d8c143e60e99ae98f014bebea1e72fc96d3c9bdf9504bc3a27af5c05bfa39f AS build

ARG APP_VERSION=v0.0.0

WORKDIR /app

COPY . .

RUN {{ $manager }} {{ eq $manager "npm" | ternary "ci" "install --frozen-lockfile" }} && \
    {{ $manager }} run build

#############################
#         STAGE RUN         #
#############################
FROM ${BASE_IMAGE}
ARG BASE_IMAGE
LABEL org.opencontainers.image.base.name="${BASE_IMAGE}"

WORKDIR /app

COPY --from=build /app/dist /usr/share/nginx/html

RUN sed -i 's#listen 80;#listen {{ .Parent.Config.Docker.Port | default 3000 }};#' /etc/nginx/conf.d/default.conf

EXPOSE {{ .Parent.Config.Docker.Port | default 3000 }}
{{- end }}

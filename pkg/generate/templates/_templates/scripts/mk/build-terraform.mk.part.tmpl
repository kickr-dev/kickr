{{- define "terraform" }}

{{- $terraform_cmd := .Parent.Config.TerraformEngine }}

fmt: ## format terraform files.
	@{{ $terraform_cmd }} fmt -diff -recursive

validate: ## validate terraform configuration.
	@{{ $terraform_cmd }} validate

plan: ## plan terraform changes.
	@{{ $terraform_cmd }} plan

test: ## run terraform tests.
	@{{ $terraform_cmd }} test
{{- end }}

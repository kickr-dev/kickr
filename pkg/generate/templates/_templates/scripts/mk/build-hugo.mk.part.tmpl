{{- define "hugo" }}

APP_VERSION ?= v0.0.0

.PHONY: build
build: ## build the hugo site.
	@hugo build --gc --destination dist --logLevel debug

.PHONY: server
server: ## serve the hugo site locally.
	@hugo server --gc --destination dist --logLevel debug --disableFastRender

{{- $netlify := and .Config.Deployment (eq .Config.Deployment.Target "netlify") }}

.PHONY: production
{{- if $netlify }}
production: ## serve the hugo site through netlify dev.
	@netlify dev -c "make server" \
		--target-port 1313 --port 8888
		--dir dist
		--framework hugo
		--context production
{{- else }}
production: build ## serve the built hugo site.
	@python3 -m http.server --directory dist
{{- end }}
{{- end }}

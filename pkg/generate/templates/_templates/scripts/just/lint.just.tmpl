<<- $go_modules := .ModulesWith "go" >>
<<- $terraform_modules := .ModulesWith "terraform" >>

<<- if gt (len $go_modules) 0 >>
<<- $name := gt (len $terraform_modules) 0 | ternary "go-lint" "lint" >>

# lint go files.
<< $name >> *ARGS:
  @golangci-lint run --config=${GOCI_LINT_PATH:-.golangci.yml} --timeout=300s --allow-parallel-runners \
    --output.text.path=stdout {{ ARGS }} || \
    echo "golangci-lint failed, running 'just << $name >>-fix' may fix some issues"

# lint and fix go files.
<< $name >>-fix:
  @just << $name >> --fix
<<- end >>

<<- if gt (len $terraform_modules) 0 >>
<<- $name := gt (len $go_modules) 0 | ternary "tflint" "lint" >>

# format terraform files.
fmt:
  @<< .Config.TerraformEngine >> fmt -diff -recursive

# lint terraform files.
<< $name >> *ARGS:
  @tflint --config "${TFLINT_PATH:-.tflint.hcl}" --recursive --format compact {{ ARGS }} || \
    echo "tflint failed, running 'just << $name >>-fix' may fix some issues"

# lint and fix terraform files.
<< $name >>-fix:
  @just << $name >> --fix
<<- end >>

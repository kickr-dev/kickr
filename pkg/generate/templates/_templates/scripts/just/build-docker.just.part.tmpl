<<- define "docker" >>

# build the docker image.
docker:
    @docker build . \
      -f Dockerfile \
      -t << .Parent.VCS.ProjectName >><< with .Slug >>/<< . >><< end >>:${APP_VERSION:-v0.0.0} \
      --build-arg GIT_REF_NAME=$(git rev-parse --abbrev-ref HEAD) \
      --build-arg GIT_COMMIT=$(git rev-parse HEAD) \
      --build-arg APP_VERSION=${APP_VERSION:-v0.0.0}
<<- end >>

jobs:
<<- define "node" >>

<<- $node_modules := .ModulesWith "node" >>

<<- $node_buildable_modules := list >>
<<- range $node_modules >>
<<- $specifics := get .Languages "node" >>
<<- $has_publish := and (not $specifics.Private) (ne $specifics.PublishConfig.Registry "") >>
<<- if or (not .HasDocker) $has_publish >><<- $node_buildable_modules = append $node_buildable_modules . >><<- end >>
<<- end >>

<<- if gt (len $node_buildable_modules) 0 >>
<<- $manager := cutAfter (get (first $node_modules).Languages "node").PackageManager "@" >>

  node-build:
    name: Node Build ${{ matrix.name }}
    runs-on: ubuntu-latest
    needs: version
    strategy:
      fail-fast: false
      matrix:
        include:
<<- range $node_buildable_modules >>
<<- $artifact := "build" >>
<<- with .Slug >><<- $artifact = print $artifact "-" . >><<- end >>
<<- if and .Config.Deployment (eq .Config.Deployment.Target "pages") >><<- $artifact = print $artifact "-pages" >><<- end >>
          - artifact: << $artifact >>
            directory: << .Dir >>
<<- if ne .Dir "." >>
            name: << printf "(%s)" .Dir >>
<<- end >>
<<- end >>
    defaults:
      run:
        working-directory: ${{ matrix.directory }}
    steps:
<<- if has "harden-runner" .Config.GitHub.Options >>
      # https://docs.stepsecurity.io/harden-runner/workflow-runs
      # https://github.com/marketplace/actions/harden-runner
      - uses: step-security/harden-runner@ccd8616d44fd3846e67624a50d5aad6d37bf2d25 # v2.22.1
        with:
          disable-sudo-and-containers: true
          egress-policy: audit
<<- end >>
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
<<- if eq $manager "pnpm" >>
      # https://github.com/marketplace/actions/setup-pnpm
      - uses: pnpm/action-setup@ea17c68df8912ef543352723c149a84f56e3d413 # v6.1.0
<<- end >>
<<- if eq $manager "bun" >>
<<- if has "step-security-actions" .Config.GitHub.Options >>
      # https://app.stepsecurity.io/github-action-advisor/step-security/setup-bun
      - uses: step-security/setup-bun@f6f5dadeac34f70c7828f731569e8d6e8330b8fb # v2.1.3
<<- else >>
      # https://github.com/marketplace/actions/setup-bun
      - uses: oven-sh/setup-bun@0c5077e51419868618aeaa5fe8019c62421857d6 # v2.2.0
<<- end >>
        with:
          bun-version-file: package.json
<<- else >>
      # https://github.com/marketplace/actions/setup-node-js-environment
      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        with:
          cache: << $manager >>
          node-version: lts/*
<<- end >>
      - run: |-
          << $manager >> << eq $manager "npm" | ternary "ci" "install --frozen-lockfile" >>
          << $manager >> run build
        env:
          APP_VERSION: ${{ needs.version.outputs.version }}
      - if: ${{ endsWith(matrix.artifact, '-pages') }}
        uses: actions/upload-pages-artifact@fc324d3547104276b827a68afc52ff2a11cc49c9 # v5
        with:
          name: ${{ matrix.artifact }}
          path: ${{ matrix.directory }}/dist
          retention-days: 1
      - if: ${{ !endsWith(matrix.artifact, '-pages') }}
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: ${{ matrix.artifact }}
          path: ${{ matrix.directory }}/dist
          retention-days: 1
<<- end >>
<<- end >>

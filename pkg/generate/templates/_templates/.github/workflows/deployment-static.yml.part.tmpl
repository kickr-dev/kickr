jobs:
<<- define "static" >>

<<- $netlify_modules := .ModulesWithDeployment "netlify" >>
<<- $pages_modules := .ModulesWithDeployment "pages" >>

<<- range $netlify_modules >>
<<- $needs := list >>
<<- if hasKey .Languages "node" >><<- $needs = append $needs "node-build" >><<- end >>
<<- if hasKey .Languages "hugo" >><<- $needs = append $needs "hugo-build" >><<- end >>
<<- $suffix := gt (len $netlify_modules) 1 | ternary .Slug "" >>

  netlify-deploy<< with $suffix >>-<< . >><< end >>:
    name: Netlify
    runs-on: ubuntu-latest
    if: ${{ inputs.netlify<< with $suffix >>_<< . >><< end >> != 'none' }}
    needs:
<<- range $needs >>
      - << . >>
<<- end >>
    environment:
      name: netlify<< with $suffix >>/<< . >><< end >>
      url: ${{ steps.netlify.outputs.deploy-url }}
    permissions:
      deployments: write
      pull-requests: write
    steps:
<<- if has "harden-runner" $.Config.GitHub.Options >>
      # https://docs.stepsecurity.io/harden-runner/workflow-runs
      # https://github.com/marketplace/actions/harden-runner
      - uses: step-security/harden-runner@bf7454d06d71f1098171f2acdf0cd4708d7b5920 # v2.20.0
        with:
          disable-sudo-and-containers: true
          egress-policy: audit
<<- end >>
      - uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0 # v7
      - uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c # v8.0.1
        with:
          name: build<< ne .Dir "." | ternary (print "-" .Dir) "" >>
          path: dist
      - id: branch_sha
        run: echo "branch_sha=$(echo "$GITHUB_REF_NAME" | sha256sum | cut -c -8)" >> $GITHUB_OUTPUT
      - id: config
        run: |-
          [ ! -f netlify.toml ] || echo "path=netlify.toml" >> $GITHUB_OUTPUT
      # https://github.com/marketplace/actions/netlify-actions
      - id: netlify
        uses: nwtgck/actions-netlify@d22a32a27c918fe470bbc562e984f80ec48c2668 # v4
        with:
          alias: ${{ steps.branch_sha.outputs.branch_sha }}
          deploy-message: ${{ github.ref_name }}
          enable-commit-comment: false
          enable-commit-status: false
          github-deployment-environment: netlify
          github-token: ${{ secrets.GITHUB_TOKEN }}
          netlify-config-path: ${{ steps.config.outputs.path }}
          production-branch: ${{ github.event.repository.default_branch }}
          publish-dir: dist
        env:
          NETLIFY_AUTH_TOKEN: ${{ secrets.NETLIFY_AUTH_TOKEN }}
          NETLIFY_SITE_ID: ${{ vars.NETLIFY_SITE_ID }}
<<- end >>

<<- if gt (len $pages_modules) 0 >>
<<- $page := first $pages_modules >>

<<- $needs := list >>
<<- if hasKey $page.Languages "node" >><<- $needs = append $needs "node-build" >><<- end >>
<<- if hasKey $page.Languages "hugo" >><<- $needs = append $needs "hugo-build" >><<- end >>

  pages:
    name: Pages
    runs-on: ubuntu-latest
    if: ${{ inputs.pages != 'none' }}
    needs:
<<- range $needs >>
      - << . >>
<<- end >>
    environment:
      name: pages
      url: ${{ steps.deployment.outputs.page_url }}
    permissions:
      id-token: write
      pages: write
      pull-requests: write
    steps:
<<- if has "harden-runner" $.Config.GitHub.Options >>
      # https://docs.stepsecurity.io/harden-runner/workflow-runs
      # https://github.com/marketplace/actions/harden-runner
      - uses: step-security/harden-runner@bf7454d06d71f1098171f2acdf0cd4708d7b5920 # v2.20.0
        with:
          disable-sudo-and-containers: true
          egress-policy: audit
<<- end >>
      - id: deployment
        uses: actions/deploy-pages@cd2ce8fcbc39b97be8ca5fce6e763baed58fa128 # v5
        with:
          artifact_name: build<< ne $page.Dir "." | ternary (print "-" $page.Dir) "" >>-pages
          preview: ${{ github.ref_name != github.event.repository.default_branch }}
<<- end >>
<<- end >>

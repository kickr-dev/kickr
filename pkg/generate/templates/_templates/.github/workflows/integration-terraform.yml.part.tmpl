jobs:
<<- define "terraform" >>

<<- $terraform_cmd := .Config.TerraformEngine >>
<<- $terraform_engine := eq $terraform_cmd "tofu" | ternary "opentofu" "terraform" >>

<<- $terraform_modules := .ModulesWith "terraform" >>
<<- $terraform_apply_modules := .ModulesWithTerraformApply >>
<<- $terraform_multiple_apply_modules := gt (len $terraform_apply_modules) 1 >>
<<- $terraform_publish_modules := .ModulesWithTerraformPublish >>

  << $terraform_engine >>-check:
    name: << title $terraform_engine >> Check ${{ matrix.name }}
    runs-on: ubuntu-latest
    needs: run-workflow
    strategy:
      fail-fast: false
      matrix:
        include:
<<- range $terraform_modules >>
          - directory: << .Dir >>
<<- if ne .Dir "." >>
            name: << printf "(%s)" .Dir >>
<<- end >>
<<- end >>
    defaults:
      run:
        working-directory: ${{ matrix.directory }}
    steps:
<<- if has "harden-runner" .Config.GitHub.Options >>
      # https://docs.stepsecurity.io/harden-runner/workflow-runs
      # https://github.com/marketplace/actions/harden-runner
      - uses: step-security/harden-runner@dc2769abcc0fcfbadfc1df54081c1608579ef6b2 # v2.22.2
        with:
          disable-sudo-and-containers: true
          egress-policy: audit
<<- end >>
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
<<- if eq $terraform_engine "terraform" >>
      - uses: hashicorp/setup-terraform@dfe3c3f87815947d99a8997f908cb6525fc44e9e # v4.0.1
        with:
          # renovate: datasource=github-tags packageName=hashicorp/terraform depName=terraform
          terraform_version: 1.17.0
<<- else >>
      - uses: opentofu/setup-opentofu@a1320f892987e89d278cc92dc5adc984fb93aca4 # v2.0.2
        with:
          # renovate: datasource=github-tags packageName=opentofu/opentofu depName=opentofu
          tofu_version: 1.13.2
<<- end >>
      - run: << $terraform_cmd >> fmt -check
      - run: << $terraform_cmd >> init -backend=false
      - run: << $terraform_cmd >> validate -no-color

<<- if gt (len $terraform_publish_modules) 0 >>
<<- $terraform_publish_dirs := list >>
<<- range $terraform_publish_modules >><<- $terraform_publish_dirs = append $terraform_publish_dirs .Dir >><<- end >>

  << $terraform_engine >>-docs:
    name: << title $terraform_engine >> Docs
    runs-on: ubuntu-latest
    needs: run-workflow
    steps:
<<- if has "harden-runner" .Config.GitHub.Options >>
      # https://docs.stepsecurity.io/harden-runner/workflow-runs
      # https://github.com/marketplace/actions/harden-runner
      - uses: step-security/harden-runner@dc2769abcc0fcfbadfc1df54081c1608579ef6b2 # v2.22.2
        with:
          disable-sudo-and-containers: true
          egress-policy: audit
<<- end >>
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - uses: terraform-docs/gh-actions@6de6da0cefcc6b4b7a5cbea4d79d97060733093c # v1.4.1
        with:
          config-file: .terraform-docs.yml
          fail-on-diff: true
          output-method: ""
          template: ""
          working-dir: << join "," $terraform_publish_dirs >>
<<- end >>

  << $terraform_engine >>-lint:
    name: << title $terraform_engine >> Lint
    runs-on: ubuntu-latest
    needs: run-workflow
    permissions:
      pull-requests: write
      security-events: write
    steps:
<<- if has "harden-runner" .Config.GitHub.Options >>
      # https://docs.stepsecurity.io/harden-runner/workflow-runs
      # https://github.com/marketplace/actions/harden-runner
      - uses: step-security/harden-runner@dc2769abcc0fcfbadfc1df54081c1608579ef6b2 # v2.22.2
        with:
          disable-sudo-and-containers: true
          egress-policy: audit
<<- end >>
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - uses: terraform-linters/setup-tflint@6ffdbaa3be476b3431f7275c26966ef32ff60337 # v6.3.2
        with:
          # renovate: datasource=github-tags packageName=terraform-linters/tflint depName=tflint
          tflint_version: v0.65.0
      - run: tflint --init
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
      - run: |-
          mkdir -p reports/
          tflint --config "$GITHUB_WORKSPACE/.tflint.hcl" --recursive --format sarif | tee reports/tflint.sarif
      - if: ${{ !cancelled() }}
        uses: github/codeql-action/upload-sarif@9b3254085494b55a0f7c4c2b3d2d52cc712ce370 # v4.39.1
        with:
          category: tflint
          sarif_file: reports/tflint.sarif

<<- range $terraform_apply_modules >>

<<- $specifics := get .Languages "terraform" >>

  << $terraform_engine >>-plan<< if $terraform_multiple_apply_modules >>-<< .Slug >><< end >>:
    name: << title $terraform_engine >> Plan (${{ matrix.environment }})<< if $terraform_multiple_apply_modules >> (<< .Dir >>)<< end >>
    runs-on: ubuntu-latest
    needs: << $terraform_engine >>-check
    environment: ${{ matrix.environment }}
    strategy:
      fail-fast: false
      matrix:
        environment:
<<- range .Config.Terraform.Environments >>
          - << . >>
<<- end >>
<<- if ne .Dir "." >>
    defaults:
      run:
        working-directory: << .Dir >>
<<- end >>
    steps:
<<- if has "harden-runner" $.Config.GitHub.Options >>
      # https://docs.stepsecurity.io/harden-runner/workflow-runs
      # https://github.com/marketplace/actions/harden-runner
      - uses: step-security/harden-runner@dc2769abcc0fcfbadfc1df54081c1608579ef6b2 # v2.22.2
        with:
          disable-sudo-and-containers: true
          egress-policy: audit
<<- end >>
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
<<- if eq $terraform_engine "terraform" >>
      - uses: hashicorp/setup-terraform@dfe3c3f87815947d99a8997f908cb6525fc44e9e # v4.0.1
        with:
          # renovate: datasource=github-tags packageName=hashicorp/terraform depName=terraform
          terraform_version: 1.17.0
<<- else >>
      - uses: opentofu/setup-opentofu@a1320f892987e89d278cc92dc5adc984fb93aca4 # v2.0.2
        with:
          # renovate: datasource=github-tags packageName=opentofu/opentofu depName=opentofu
          tofu_version: 1.13.2
<<- end >>
      - run: |-
          << $terraform_cmd >> init
          << $terraform_cmd >> plan -no-color
<<- if or (gt (len $specifics.Variables) 0) (eq $specifics.StateBackend "s3") >>
        env:
<<- if eq $specifics.StateBackend "s3" >>
          AWS_ACCESS_KEY: ${{ secrets.AWS_ACCESS_KEY }}
          AWS_SECRET_KEY: ${{ secrets.AWS_SECRET_KEY }}
<<- end >>
<<- range $name, $var := $specifics.Variables >>
<<- $source := $var.Sensitive | ternary "secrets" "vars" >>
<<- if and (hasPrefix "github_" $name) (ne "github_token" $name) >>
          TF_VAR_<< $name >>: ${{ << print "github." (trimPrefix "github_" $name) >> }}
<<- else >>
          TF_VAR_<< $name >>: ${{ << print $source "." (upper $name) >> }}
<<- end >>
<<- end >>
<<- end >>
<<- end >>
<<- end >>

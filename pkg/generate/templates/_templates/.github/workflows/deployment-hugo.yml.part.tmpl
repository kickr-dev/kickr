jobs:
<<- define "hugo" >>

<<- $hugo_buildable_modules := list >>
<<- range .ModulesWith "hugo" >><<- if not .HasDocker >><<- $hugo_buildable_modules = append $hugo_buildable_modules . >><<- end >><<- end >>

<<- if gt (len $hugo_buildable_modules) 0 >>

  hugo-build:
    name: Hugo Build ${{ matrix.name }}
    runs-on: ubuntu-latest
    needs: version
    strategy:
      fail-fast: false
      matrix:
        include:
<<- range $hugo_buildable_modules >>
<<- $artifact := "build" >>
<<- if ne .Dir "." >><<- $artifact = print $artifact "-" .Dir >><<- end >>
<<- if and .Config.Deployment (eq .Config.Deployment.Target "pages") >><<- $artifact = print $artifact "-pages" >><<- end >>
          - artifact: << $artifact >>
            directory: << .Dir >>
<<- if ne .Dir "." >>
            name: << printf "(%s)" .Dir >>
<<- end >>
<<- end >>
    defaults:
      run:
        working-directory: ${{ matrix.directory }}
    steps:
<<- if has "harden-runner" .Config.GitHub.Options >>
      # https://docs.stepsecurity.io/harden-runner/workflow-runs
      # https://github.com/marketplace/actions/harden-runner
      - uses: step-security/harden-runner@bf7454d06d71f1098171f2acdf0cd4708d7b5920 # v2.20.0
        with:
          disable-sudo-and-containers: true
          egress-policy: audit
<<- end >>
      - uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0 # v7
        with:
          fetch-depth: 0 # fetch all history for .GitInfo and .Lastmod
          submodules: true # fetch Hugo themes
      - uses: jdx/mise-action@dad1bfd3df957f44999b559dd69dc1671cb4e9ea # v4.2.1
        with:
          # renovate: datasource=github-tags packageName=jdx/mise depName=mise
          version: v2026.7.10
          install: false
          cache: true
      - run: |-
          # renovate: datasource=golang-version packageName=golang/go depName=golang
          - mise use -g golang@1.26.5
          # renovate: datasource=github-tags packageName=gohugoio/hugo depName=hugo
          - mise use -g hugo-extended@0.164.0
          # renovate: datasource=github-tags packageName=sass/dart-sass depName=dart-sass
          - mise use -g github:sass/dart-sass@1.101.2
      - run: hugo --gc --enableGitInfo --minify --destination dist --logLevel "$LOG_LEVEL"
        env:
          LOG_LEVEL: ${{ vars.HUGO_LOG_LEVEL || 'info' }}
          APP_VERSION: ${{ needs.version.outputs.version }}
      - if: ${{ endsWith(matrix.artifact, '-pages') }}
        uses: actions/upload-pages-artifact@fc324d3547104276b827a68afc52ff2a11cc49c9 # v5
        with:
          name: ${{ matrix.artifact }}
          path: ${{ matrix.directory }}/dist
          retention-days: 1
      - if: ${{ !endsWith(matrix.artifact, '-pages') }}
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
        with:
          name: ${{ matrix.artifact }}
          path: ${{ matrix.directory }}/dist
          retention-days: 1
<<- end >>
<<- end >>

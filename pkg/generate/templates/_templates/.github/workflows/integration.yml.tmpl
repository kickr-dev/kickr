<<- if has "harden-runner" .Config.GitHub.Options >>
      # https://docs.stepsecurity.io/harden-runner/workflow-runs
      # https://github.com/marketplace/actions/harden-runner
      - uses: step-security/harden-runner@bf7454d06d71f1098171f2acdf0cd4708d7b5920 # v2.20.0
        with:
          disable-sudo-and-containers: true
          egress-policy: audit
<<- end >>
      - if: ${{ contains(needs.*.result, 'failure') || contains(needs.*.result, 'skipped') || contains(needs.*.result, 'cancelled') }}
        run: echo "Some jobs didn't end with success status" && exit 1
      - run: echo "All jobs ended with success"

<<- $deploy := or
  (and $has_docker .Config.Docker.Auto)
  (and .Config.Helm (or (eq .Config.Helm.Deploy "auto") (eq .Config.Helm.Publish "auto")))
  .Config.HasTerraformAutoApply
  .Config.HasDeploymentAuto
>>
<<- $release := and .Config.GitHub.Release .Config.GitHub.Release.Auto >>
<<- if or $deploy $release >>

  notify-workflow:
    name: Notify Workflow
    runs-on: ubuntu-Latest
    if: ${{ github.event_name == 'push' }}
    needs: workflow-status
    permissions:
      actions: write
    strategy:
      fail-fast: false
      matrix:
        workflow:
          - deployment
    steps:
<<- if has "harden-runner" .Config.GitHub.Options >>
      # https://docs.stepsecurity.io/harden-runner/workflow-runs
      # https://github.com/marketplace/actions/harden-runner
      - uses: step-security/harden-runner@bf7454d06d71f1098171f2acdf0cd4708d7b5920 # v2.20.0
        with:
          disable-sudo-and-containers: true
          egress-policy: audit
<<- end >>
      - uses: actions/github-script@3a2844b7e9c422d3c10d287c895573f7108da1b3 # v9
        with:
          result-encoding: string
          script: |-
            await github.rest.actions.createWorkflowDispatch({
              owner: context.repo.owner,
              ref: process.env.GITHUB_REF_NAME,
              repo: context.repo.repo,
              workflow_id: process.env.WORKFLOW_ID,
            })
        env:
          WORKFLOW_ID: ${{ matrix.workflow }}.yml
<<- end >>

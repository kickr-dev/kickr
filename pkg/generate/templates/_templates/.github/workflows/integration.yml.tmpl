name: Integration
run-name: Integration

<<- $go_modules := .ModulesWith "go" >>
<<- $node_modules := .ModulesWith "node" >>
<<- $has_docker := .HasDocker >>
<<- $shell := and (not (has "shell" .Config.Exclude)) (.HasGlob "shell") >>

<<- $terraform_modules := .ModulesWith "terraform" >>
<<- $terraform_apply_modules := .ModulesWithTerraformApply >>
<<- $terraform_cmd := .Config.TerraformEngine >>

on:
  pull_request:
    types:
      - opened
      - reopened
      - synchronize
      - ready_for_review
  push:
    branches:
      - alpha
      - beta
      - dev
      - develop
      - next
      - staging
      - main
      - v[0-9]+.x
      - v[0-9]+.[0-9]+.x
  workflow_dispatch:

concurrency:
  group: ${{ github.workflow }}-${{ github.head_ref || github.ref_name }}
  cancel-in-progress: true

permissions:
  contents: read

jobs:
  run-workflow:
    name: Run
    runs-on: ubuntu-latest
    if: ${{ github.event_name == 'workflow_dispatch' || github.ref_protected || !github.event.pull_request.draft }}
    outputs:
      skip: ${{ steps.skip.outputs.skip }}
    permissions:
      pull-requests: read
    steps:
<<- if has "harden-runner" .Config.GitHub.Options >>
      # https://docs.stepsecurity.io/harden-runner/workflow-runs
      # https://github.com/marketplace/actions/harden-runner
      - uses: step-security/harden-runner@bf7454d06d71f1098171f2acdf0cd4708d7b5920 # v2.20.0
        with:
          disable-sudo-and-containers: true
          egress-policy: audit
<<- end >>

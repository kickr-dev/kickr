    runs-on: ubuntu-latest
    if: ${{ always() && (github.event_name != 'pull_request' || !github.event.pull_request.draft) }}
    needs:
<<- if $has_docker >>
      - docker-hadolint
<<- end >>
<<- if gt (len $go_modules) 0 >>
      - go-test
<<- end >>
<<- if .Config.Helm >>

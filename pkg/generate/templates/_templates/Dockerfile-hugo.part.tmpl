{{- define "hugo" }}

{{- $specifics := get .Languages "hugo" }}

ARG BASE_IMAGE=nginx:1.31.10-alpine3.24@sha256:7fc0fb4af7bf006aeb31aea88069976060f8f0a0a86b667126742cc17f4e31ae

#############################
#        STAGE BUILD        #
#############################
{{- if $specifics.ContainerImage }}
FROM {{ $specifics.ContainerImage }} AS build
{{- else }}
FROM ghcr.io/gohugoio/hugo:v0.170.1@sha256:4cc9f383086c0fba180efcf7132cf2f025969c462fedf5fcd2bf921915416797 AS build
{{- end }}

WORKDIR /app

COPY . .

RUN hugo build --gc --destination dist

#############################
#         STAGE RUN         #
#############################
FROM ${BASE_IMAGE}
ARG BASE_IMAGE
LABEL org.opencontainers.image.base.name="${BASE_IMAGE}"

WORKDIR /app

COPY --from=build /app/dist /usr/share/nginx/html

RUN sed -i 's#listen 80;#listen {{ .Parent.Config.Docker.Port | default 3000 }};#' /etc/nginx/conf.d/default.conf

EXPOSE {{ .Parent.Config.Docker.Port | default 3000 }}
{{- end }}

{{- define "golang" }}

{{- $specifics := get .Languages "go" }}

{{- $binaries := dict }}
{{- $_ := map $binaries .Clis .Crons .Jobs .Workers }}

ARG BASE_IMAGE=gcr.io/distroless/static-debian13:nonroot@sha256:f7f8f729987ad0fdf6b05eeeae94b26e6a0f613bdf46feea7fc40f7bd72953e6

#############################
#        STAGE BUILD        #
#############################
{{- if $specifics.ContainerImage }}
FROM {{ $specifics.ContainerImage }} AS build
{{- else }}
FROM docker.io/library/golang:1.27.2-trixie@sha256:47667934874913a449b96faa7ef4777fa285d9ec29126ee80ed61c45b7cccf0e AS build
{{- end }}

ARG CGO_ENABLED=0
ARG GIT_REF_NAME
ARG GIT_COMMIT
ARG APP_VERSION=v0.0.0

WORKDIR /app

COPY . .

RUN go mod download{{ range $name, $_ := $binaries }} && \
    CGO_ENABLED=$CGO_ENABLED go build \
        -ldflags "\
            -X '{{ $specifics.Module }}/internal/build.branch=$GIT_REF_NAME' \
            -X '{{ $specifics.Module }}/internal/build.commit=$GIT_COMMIT' \
            -X '{{ $specifics.Module }}/internal/build.date=$(TZ="UTC" date '+%Y-%m-%dT%TZ')' \
            -X '{{ $specifics.Module }}/internal/build.version=$APP_VERSION' \
        " \
        -o {{ $name }} ./cmd/{{ $name }}
{{- end }}

#############################
#         STAGE RUN         #
#############################
FROM ${BASE_IMAGE}
ARG BASE_IMAGE
LABEL org.opencontainers.image.base.name="${BASE_IMAGE}"

WORKDIR /app

COPY --from=build \
{{- range $name, $_ := $binaries }}
    /app/{{ $name }} \
{{- end }}
    ./

{{- $entrypoint := "launcher.sh" }}

{{- if eq .Binaries 1 }}

{{- /* directly use the only binary */ -}}
{{- range $name, $_ := $binaries }}
{{- $entrypoint = $name }}
{{- end }}

{{- end }}

{{- /* copy launcher if the entrypoint is the launcher */ -}}
{{- if eq $entrypoint "launcher.sh" }}
COPY launcher.sh launcher.sh
{{- end }}

EXPOSE {{ .Parent.Config.Docker.Port | default 3000 }}

ENTRYPOINT [ "/app/{{ $entrypoint }}" ]
{{- end }}

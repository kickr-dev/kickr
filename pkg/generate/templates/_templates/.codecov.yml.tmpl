# Code generated by kickr; DO NOT EDIT.

coverage:
  precision: 2
  round: down
  range: 85...100

  status:
    project:
      default:
        threshold: 2.5%
    patch:
      default:
        threshold: 2.5%

{{- $go_modules := .ModulesWith "go" }}
{{- $node_modules := .ModulesWith "node" }}

ignore:
{{- if gt (len $go_modules) 0 }}
  - cmd
  - examples
  - testdata
  - testutils
  - "**/build.go"
  - "**/cobra/**"
  - "**/logger.go"
  - "**/testdata/**"
  - "**/testutils/**"
{{- end }}
{{- if gt (len $node_modules) 0 }}
  - dist
  - node_modules
  - public
  - "**/*.spec.js"
  - "**/*.spec.ts"
  - "**/*.test.js"
  - "**/*.test.ts"
{{- end }}

// Code generated by kickr; DO NOT EDIT.

// https://docs.renovatebot.com/self-hosted-configuration/

{{- $overrides := and .Config.GitLab (has "renovate:overrides" .Config.GitLab.Options) }}

{
    "$schema": "https://docs.renovatebot.com/renovate-global-schema.json",
{{- if $overrides }}

    "extends": [
        "local>{{ .VCS.ProjectPath }}//.gitlab/renovate.local.json"
    ],
{{- end }}

    "allowedCommands": [
        "^git diff --exit-code -G\\^go -- go\\.mod$",
        "^go mod tidy$",
        "^hugo mod tidy$"
    ],
    "autodiscover": true,
{{- if not .HasLanguages }}
    "autodiscoverNamespaces": ["{{ trimSuffix (print "/" .VCS.ProjectName) .VCS.ProjectPath }}"],
{{- else }}
    "autodiscoverFilter": ["{{ .VCS.ProjectPath }}"],
{{- end }}
    "configValidationError": true,
    "onboarding": false,
    "suppressNotifications": ["configErrorIssue"]
}

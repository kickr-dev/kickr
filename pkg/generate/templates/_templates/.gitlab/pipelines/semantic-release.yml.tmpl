{{- $go_modules := .ModulesWith "go" }}
{{- $has_go_build := and (gt (len $go_modules) 0) (gt .Executables.Binaries 0) }}

{{- $node_modules := .ModulesWith "node" }}
{{- $has_node_main := false }}
{{- range $node_modules }}{{- if (get .Languages "node").Main }}{{- $has_node_main = true }}{{- end }}{{- end }}

---
include:
  # semantic-release template
  # https://gitlab.com/to-be-continuous/semantic-release
  - remote: https://gitlab.com/to-be-continuous/semantic-release/-/raw/f7c8ec592083596d1b392778582f160c1a2a0379/templates/gitlab-ci-semrel.yml # 4.3.0
    inputs:
{{- if and .Config.GitLab.Release .Config.GitLab.Release.Auto }}
      auto-release-enabled: $CI_COMMIT_REF_PROTECTED
{{- else }}
      auto-release-enabled: "false"
{{- end }}
      branches-ref: /^(alpha|beta|dev|develop|main|next|rc|staging|v[0-9]+(\.[0-9]+)?\.x)$/
      hooks-dir: scripts
      info-on: all
      release-disabled: "{{ not .Config.GitLab.Release }}"
{{- if .Config.GitLab.Release }}
      required-plugins-file: .gitlab/semrel-plugins.txt
{{- end }}
      tag-format: v$${version}

{{- if not .Config.GitLab.Release }}

.semrel-base:
  variables:
    GIT_DEPTH: "0"

semantic-release-info:
  stage: build
  script:
    - DESCRIBE=$(git describe --tags || echo "v1.0.0")
    - echo "SEMREL_INFO_NEXT_VERSION=v${DESCRIBE#v}" >> "$SEMREL_CONFIG_DIR/semrel.out.env"
    - echo "SEMREL_INFO_NEXT_VERSION_TYPE=build" >> "$SEMREL_CONFIG_DIR/semrel.out.env"
    - cat "$SEMREL_CONFIG_DIR/semrel.out.env"

{{- else }}

.semrel-base:
  variables:
    GIT_DEPTH: "0"
    GITLAB_TOKEN: $RELEASE_TOKEN
{{- if gt (len $node_modules) 0 }}
{{- $firstnode := get (first $node_modules).Languages "node" }}
{{- if and (not $firstnode.Private) (eq $firstnode.PublishConfig.Registry "") }}
  id_tokens:
    NPM_ID_TOKEN:
      aud: npm:registry.npmjs.org
    SIGSTORE_ID_TOKEN:
      aud: sigstore
{{- end }}
{{- end }}

semantic-release-info:
  stage: build
  variables:
    SEMREL_DRY_RUN: "true"
  script:
    - !reference [semantic-release, script]
    - |
      if [ -f "$SEMREL_CONFIG_DIR/semrel.out.env" ]; then
        source "$SEMREL_CONFIG_DIR/semrel.out.env"
        rm "$SEMREL_CONFIG_DIR/semrel.out.env"
      fi
    - |
      echo "BRANCH_SHA=$(echo "$CI_COMMIT_REF_NAME" | sha256sum | cut -c -8)" >> "$SEMREL_CONFIG_DIR/semrel.out.env"

      if [ -n "$SEMREL_INFO_NEXT_VERSION" ]; then
        echo "SEMREL_INFO_LAST_VERSION=v${SEMREL_INFO_LAST_VERSION#v}" >> "$SEMREL_CONFIG_DIR/semrel.out.env"
        echo "SEMREL_INFO_NEXT_VERSION=v${SEMREL_INFO_NEXT_VERSION#v}" >> "$SEMREL_CONFIG_DIR/semrel.out.env"
        echo "SEMREL_INFO_NEXT_VERSION_TYPE=${SEMREL_INFO_NEXT_VERSION_TYPE}" >> "$SEMREL_CONFIG_DIR/semrel.out.env"
      else
        DESCRIBE=$(git describe --tags || echo "v1.0.0")
        echo "SEMREL_INFO_NEXT_VERSION=v${DESCRIBE#v}" >> "$SEMREL_CONFIG_DIR/semrel.out.env"
        echo "SEMREL_INFO_NEXT_VERSION_TYPE=build" >> "$SEMREL_CONFIG_DIR/semrel.out.env"
      fi
    - cat "$SEMREL_CONFIG_DIR/semrel.out.env"

{{- $dependencies := list }}
{{- if $has_go_build }}{{- $dependencies = append $dependencies "go-build" }}{{- end }}
{{- if $has_node_main }}{{- $dependencies = append $dependencies "node-build" }}{{- end }}

semantic-release:
  interruptible: false
{{- if gt (len $dependencies) 0 }}
  dependencies:
{{- range $dependencies }}
    - {{ . }}
{{- end }}
{{- end }}
{{- end }}

semantic-release:dry-run:
  extends: semantic-release
  variables:
    SEMREL_DRY_RUN: "true"

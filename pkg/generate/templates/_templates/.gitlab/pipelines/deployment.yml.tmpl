{{- if $docker }}
{{- $nodes := list }}
{{- range .Modules }}{{- if .HasDocker }}{{- $nodes = append $nodes . }}{{- end }}{{- end }}
{{- $firstnode := first $nodes }}

{{- $registry := .Docker.Registry | default "${CI_REGISTRY}" }}
{{- $path := .Docker.Path | default "${CI_PROJECT_PATH}" }}

  # Docker template
  # https://gitlab.com/to-be-continuous/docker
  - remote: https://gitlab.com/to-be-continuous/docker/-/raw/44e82817b367db9a3cb56fa4f0f749afd167136c/templates/gitlab-ci-docker.yml # 8.4.2
    inputs:
      build-args: |
        --build-arg GIT_REF_NAME=$CI_COMMIT_REF_NAME
        --build-arg GIT_COMMIT=$CI_COMMIT_SHA
        --build-arg APP_VERSION=$APP_VERSION
        --label org.opencontainers.image.created=$CI_JOB_STARTED_AT
        --label org.opencontainers.image.ref.name=$CI_COMMIT_REF_NAME
        --label org.opencontainers.image.revision=$CI_COMMIT_SHA
        --label org.opencontainers.image.version=$APP_VERSION
      build-tool: buildah
{{- if and (eq (len $nodes) 1) (ne $firstnode.Dir ".") }}
      file: {{ $firstnode.Dir }}/Dockerfile
{{- end }}
      healthcheck-disabled: "true" # https://docs.docker.com/reference/dockerfile/#healthcheck
      release-extra-tags: latest \\g<major> \\g<major>.\\g<minor>
      release-image: "{{ $registry }}/{{ $path }}{{ if gt (len $nodes) 1 }}/${DOCKER_IMAGE_NAME}{{ end }}:$APP_VERSION"
      semrel-release-disabled: "true" # handled by docker build and push jobs to avoid too much dependency on semantic-release
      snapshot-image: "{{ $registry }}/{{ $path }}{{ if gt (len $nodes) 1 }}/${DOCKER_IMAGE_NAME}{{ end }}/snapshot:$APP_VERSION"
      trivy-args: --ignore-unfixed --exit-code 1 --exit-on-eol 1
{{- end }}

{{- if .Helm }}
{{- $registry := .Helm.Registry | default "oci://$CI_REGISTRY" }}
{{- $path := .Helm.Path | default "$CI_PROJECT_PATH/charts" }}

  # Helm template
  # https://gitlab.com/to-be-continuous/helm
  - remote: https://gitlab.com/to-be-continuous/helm/-/raw/412aa89432d038e3fb066b6b9478be9be2135e42/templates/gitlab-ci-helm.yml # 9.6.3
    inputs:
      chart-dir: chart/
      integ-enabled: "{{ and .HasHelmDeploy (has "integration" .Helm.Environments) }}"
      package-args: package --version "$APP_VERSION" --app-version "$APP_VERSION" --dependency-update
      prod-enabled: "{{ and .HasHelmDeploy (has "production" .Helm.Environments) }}"
      publish-method: {{ .HasHelmPublish | ternary "push" "disabled" }}
      publish-on: {{ .HasHelmPublish | ternary "all" "none" }}
      publish-snapshot-enabled: "false"
      publish-strategy: {{ .Helm.Publish | default "none" }}
{{- if .HasHelmPublish }}
      publish-url: {{ $registry }}/{{ trimSuffix (print "/" .VCS.ProjectName) $path }}
{{- end }}
      review-enabled: "{{ and .HasHelmDeploy (has "review" .Helm.Environments) }}"
      scripts-dir: chart/hooks/
      semrel-release-disabled: "true" # version is handled manually
      staging-enabled: "{{ and .HasHelmDeploy (has "staging" .Helm.Environments) }}"
      test-enabled: "false"
{{- if .HasHelmDeploy }}
      deploy-args: upgrade --install --version "$APP_VERSION" -f "$HELM_CHART_DIR/values.yaml" --set "appVersion=$APP_VERSION"
      integ-app-name: $HELM_BASE_APP_NAME
{{- if has "production" .Helm.Environments }}
      prod-deploy-strategy: {{ .Helm.Deploy }}
{{- end }}
      review-app-name: $HELM_BASE_APP_NAME-$APP_VERSION
      staging-app-name: $HELM_BASE_APP_NAME
{{- end }}
{{- end }}

{{- if $terraform }}

  # Terraform template
  # https://gitlab.com/to-be-continuous/terraform
  - remote: https://gitlab.com/to-be-continuous/terraform/-/raw/8a16e0037dd185058eefa4fcace694a4984b7408/templates/gitlab-ci-terraform.yml # 9.3.2
    inputs:
      fmt-enabled: "true"
      gitlab-backend-disabled: "true"
      integ-enabled: "false"
      prod-enabled: "false"
      review-enabled: "false"
      staging-enabled: "false"
      trivy-args: --disable-telemetry --skip-version-check . --ignorefile $CI_PROJECT_DIR/.trivyignore.yaml
      validate-enabled: "true"
{{- end }}
{{- if has "overrides:deployment" .GitLab.Options }}
  - local: .gitlab/deployment.overrides.yml
{{- end }}

{{- if and .Website .Website.Hosting (or $docker .Helm $terraform) }}{{ print "\n" }}{{- end }}{{/* simple ugly pretty print */}}
{{- if .Website }}{{ template "static" . }}{{- end }}

{{- if $docker }}
{{- $nodes := list }}
{{- range .Modules }}{{- if .HasDocker }}{{- $nodes = append $nodes . }}{{- end }}{{- end }}
{{- if gt (len $nodes) 1 }}

.docker-base:
  parallel:
    matrix:
{{- range $nodes }}
      - DOCKER_IMAGE_NAME: {{ .Slug | default ("" | quote) }}
        DOCKER_FILE: {{ .Dir }}/Dockerfile
{{- end }}
{{- end }}
{{- end }}

{{- if and $terraform .HasTerraformApply }}
{{- range .ModulesWith "terraform" }}

tf-deploy-{{ .Slug }}:
  stage: infra-prod
  trigger:
    strategy: mirror
    forward:
      yaml_variables: false
      pipeline_variables: false
    include:
      # Terraform template
      # https://gitlab.com/to-be-continuous/terraform
      - remote: https://gitlab.com/to-be-continuous/terraform/-/raw/8a16e0037dd185058eefa4fcace694a4984b7408/templates/gitlab-ci-terraform.yml # 9.3.2
        inputs:
          environment-namespace: /{{ .Slug | default "root" }}
          gitlab-backend-disabled: "{{ ne (get .Languages "terraform").Backend "http" }}"
          integ-enabled: "{{ has "integration" $.Terraform.Environments }}"
          prod-enabled: "{{ has "production" $.Terraform.Environments }}"
          project-dir: {{ .Dir }}
          review-enabled: "{{ has "review" $.Terraform.Environments }}"
          staging-enabled: "{{ has "staging" $.Terraform.Environments }}"
          tflint-disabled: "true"
          trivy-disabled: "true"
{{- if has "overrides:deployment" $.GitLab.Options }}
      - local: .gitlab/deployment.overrides.yml
{{- end }}
      - local: .gitlab/variables.yml
{{- end }}
{{- end }}

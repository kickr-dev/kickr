# Code generated by kickr; DO NOT EDIT.

{{- $terraform_modules := .ModulesWith "terraform" }}

{{- $has_docker := .HasDocker }}
{{- $docker_modules := list }}
{{- range .Modules }}{{- if .HasDocker }}{{- $docker_modules = append $docker_modules . }}{{- end }}{{- end }}

{{- $netlify_modules := .ModulesWithDeployment "netlify" }}
{{- $pages_modules := .ModulesWithDeployment "pages" }}
{{- $static := or (gt (len $netlify_modules) 0) (gt (len $pages_modules) 0) }}

{{- $has_include := or $has_docker .Config.Helm (gt (len $terraform_modules) 0) }}

---
include:{{ if not $has_include }} []{{ end }}

{{- if $has_docker }}
{{- $firstnode := first $docker_modules }}

{{- $registry := .Config.Docker.Registry | default "${CI_REGISTRY}" }}
{{- $path := .Config.Docker.Path | default "${CI_PROJECT_PATH}" }}

  # Docker template
  # https://gitlab.com/to-be-continuous/docker
  - remote: https://gitlab.com/to-be-continuous/docker/-/raw/ad253fc7bf6a8d1a53111d09b7bad19f4b5c65b9/templates/gitlab-ci-docker.yml # 8.5.1
    inputs:
      build-args: |
        --build-arg GIT_REF_NAME=$CI_COMMIT_REF_NAME
        --build-arg GIT_COMMIT=$CI_COMMIT_SHA
        --build-arg APP_VERSION=$APP_VERSION
        --label org.opencontainers.image.created=$CI_JOB_STARTED_AT
        --label org.opencontainers.image.ref.name=$CI_COMMIT_REF_NAME
        --label org.opencontainers.image.revision=$CI_COMMIT_SHA
        --label org.opencontainers.image.version=$APP_VERSION
      build-tool: buildah
{{- if and (eq (len $docker_modules) 1) (ne $firstnode.Dir ".") }}
      file: {{ $firstnode.Dir }}/Dockerfile
{{- end }}
      healthcheck-disabled: "true" # https://docs.docker.com/reference/dockerfile/#healthcheck
      release-extra-tags: latest \\g<major> \\g<major>.\\g<minor>
      release-image: "{{ $registry }}/{{ $path }}{{ if gt (len $docker_modules) 1 }}/${DOCKER_IMAGE_NAME}{{ end }}:$APP_VERSION"
      semrel-release-disabled: "true" # handled by docker build and push jobs to avoid too much dependency on semantic-release
      snapshot-image: "{{ $registry }}/{{ $path }}{{ if gt (len $docker_modules) 1 }}/${DOCKER_IMAGE_NAME}{{ end }}/snapshot:$APP_VERSION"
      trivy-args: --ignore-unfixed --exit-code 1 --exit-on-eol 1
{{- end }}

{{- if .Config.Helm }}
{{- $registry := .Config.Helm.Registry | default "oci://$CI_REGISTRY" }}
{{- $path := .Config.Helm.Path | default "$CI_PROJECT_PATH/charts" }}

  # Helm template
  # https://gitlab.com/to-be-continuous/helm
  - remote: https://gitlab.com/to-be-continuous/helm/-/raw/e5636d90883f5969a4d6a35042bc74080f5ec276/templates/gitlab-ci-helm.yml # 9.7.0
    inputs:
      chart-dir: chart/
      integ-enabled: "{{ and .Config.HasHelmDeploy (has "integration" .Config.Helm.Environments) }}"
      package-args: package --version "$APP_VERSION" --app-version "$APP_VERSION" --dependency-update
      prod-enabled: "{{ and .Config.HasHelmDeploy (has "production" .Config.Helm.Environments) }}"
      publish-method: {{ .Config.HasHelmPublish | ternary "push" "disabled" }}
      publish-on: {{ .Config.HasHelmPublish | ternary "all" "none" }}
      publish-snapshot-enabled: "false"
      publish-strategy: {{ .Config.Helm.Publish | default "none" }}
{{- if .Config.HasHelmPublish }}
      publish-url: {{ $registry }}/{{ trimSuffix (print "/" .VCS.ProjectName) $path }}
{{- end }}
      review-enabled: "{{ and .Config.HasHelmDeploy (has "review" .Config.Helm.Environments) }}"
      scripts-dir: chart/hooks/
      semrel-release-disabled: "true" # version is handled manually
      staging-enabled: "{{ and .Config.HasHelmDeploy (has "staging" .Config.Helm.Environments) }}"
      test-enabled: "false"
{{- if .Config.HasHelmDeploy }}
      deploy-args: upgrade --install --version "$APP_VERSION" -f "$HELM_CHART_DIR/values.yaml" --set "appVersion=$APP_VERSION"
      integ-app-name: $HELM_BASE_APP_NAME
{{- if has "production" .Config.Helm.Environments }}
      prod-deploy-strategy: {{ .Config.Helm.Deploy }}
{{- end }}
      review-app-name: $HELM_BASE_APP_NAME-$APP_VERSION
      staging-app-name: $HELM_BASE_APP_NAME
{{- end }}
{{- end }}

{{- if gt (len $terraform_modules) 0 }}

  # Terraform template
  # https://gitlab.com/to-be-continuous/terraform
  - remote: https://gitlab.com/to-be-continuous/terraform/-/raw/fef22b89d78f356aeac7b7357fd8e5984d05bbca/templates/gitlab-ci-terraform.yml # 9.4.0
    inputs:
      fmt-enabled: "true"
      gitlab-backend-disabled: "true"
      integ-enabled: "false"
      prod-enabled: "false"
      review-enabled: "false"
      staging-enabled: "false"
      trivy-args: --disable-telemetry --skip-version-check . --ignorefile $CI_PROJECT_DIR/.trivyignore.yaml
      validate-enabled: "true"
{{- end }}
{{- if has "overrides:deployment" .Config.GitLab.Options }}
  - local: .gitlab/deployment.overrides.yml
{{- end }}

{{- if $static }}{{ template "static" . }}{{- end }}

{{- if $has_docker }}
{{- if gt (len $docker_modules) 1 }}

.docker-base:
  parallel:
    matrix:
{{- range $docker_modules }}
      - DOCKER_IMAGE_NAME: {{ .Slug | default ("" | quote) }}
        DOCKER_FILE: {{ .Dir }}/Dockerfile
{{- end }}
{{- end }}
{{- end }}

{{- if gt (len $terraform_modules) 0 }}
{{- range .ModulesWithTerraformApply }}

tf-deploy{{ with .Slug }}-{{ . }}{{ end }}:
  stage: infra-prod
  trigger:
    strategy: mirror
    forward:
      yaml_variables: false
      pipeline_variables: false
    include:
      # Terraform template
      # https://gitlab.com/to-be-continuous/terraform
      - remote: https://gitlab.com/to-be-continuous/terraform/-/raw/fef22b89d78f356aeac7b7357fd8e5984d05bbca/templates/gitlab-ci-terraform.yml # 9.4.0
        inputs:
          environment-namespace: {{ ne .Slug "" | ternary (print "/" .Slug) ("" | quote) }}
          gitlab-backend-disabled: "{{ ne (get .Languages "terraform").Backend "http" }}"
          integ-enabled: "{{ has "integration" .Config.Terraform.Environments }}"
          prod-enabled: "{{ has "production" .Config.Terraform.Environments }}"
          project-dir: {{ .Dir }}
          review-enabled: "{{ has "review" .Config.Terraform.Environments }}"
          staging-enabled: "{{ has "staging" .Config.Terraform.Environments }}"
          tflint-disabled: "true"
          trivy-disabled: "true"
{{- if has "overrides:deployment" $.Config.GitLab.Options }}
      - local: .gitlab/deployment.overrides.yml
{{- end }}
      - local: .gitlab/variables.yml
{{- end }}
{{- end }}

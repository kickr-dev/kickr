# Code generated by kickr; DO NOT EDIT.

{{- $golang := .HasLanguage "go" }}
{{- $hugo := .HasLanguage "hugo" }}

{{- $node := .HasLanguage "node" }}

{{- $buildable := list }}
{{- range .ModulesWith "node" }}
{{- $specifics := get .Languages "node" }}
{{- $publish := and (not $specifics.Private) (ne $specifics.PublishConfig.Registry "") }}
{{- if or (not .HasDocker) $publish }}{{- $buildable = append $buildable . }}{{- end }}
{{- end }}

{{- $precommit := and (not (has "pre-commit" .Exclude)) (not (has "pre-commit" .GitLab.Exclude)) }}
{{- $shell := and (not (has "shell" .Exclude)) (.HasGlob "shell") }}

---
include:
{{- if $precommit }}

  # pre-commit template
  # https://gitlab.com/to-be-continuous/pre-commit
  - remote: https://gitlab.com/to-be-continuous/pre-commit/-/raw/545565bb99ba3b932c9f1f244d446d5ff3f77b40/templates/gitlab-ci-pre-commit.yml # 1.6.0
    inputs:
      pre-commit-file: .pre-commit-config.yaml
{{- end }}

{{- if $shell }}

  # Bash template
  # https://gitlab.com/to-be-continuous/bash
  - remote: https://gitlab.com/to-be-continuous/bash/-/raw/25e0ab61ffadef08b7cda4032afbaa859aebc280/templates/gitlab-ci-bash.yml # 3.10.0
    inputs:
      bats-enabled: "false"
      shellcheck-files: "**/*.*sh"
{{- end }}

{{- if $golang }}

  # Go template
  # https://gitlab.com/to-be-continuous/golang
  - remote: https://gitlab.com/to-be-continuous/golang/-/raw/6198ec5ccac22639a2e739437f0e922cd3f9f178/templates/gitlab-ci-golang.yml # 4.17.2
    inputs:
      build-mode: modules
      ci-lint-args: --config=.golangci.yml --timeout=300s --allow-parallel-runners --output.checkstyle.path="reports/go-ci-lint.checkstyle.xml" --output.text.path=stdout
      sbom-opts: -licenses -assert-licenses
      test-flags: -v -coverpkg=./... -covermode=count -timeout=30s
{{- if and $golang (gt .Executables.Binaries 0) }}
      test-image: $GO_IMAGE
{{- end }}
{{- end }}

{{- if $node }}

  # Node.js template
  # https://gitlab.com/to-be-continuous/node
  - remote: https://gitlab.com/to-be-continuous/node/-/raw/1fdebb262a573058989e3a4fc3fd47899edd9b4c/templates/gitlab-ci-node.yml # 5.4.0
    inputs:
      build-dir: $BUILD_DIR
      build-disabled: "{{ eq (len $buildable) 0 }}"
      lint-enabled: "true"
      lint-args: run lint --ignore-pattern .bun --ignore-pattern .npm --ignore-pattern .yarn
{{- if eq (len $buildable) 1 }}
{{- $firstnode := first $buildable }}
{{- if ne $firstnode.Dir "." }}
      project-dir: {{ $firstnode.Dir }}
{{- end }}
      publish-enabled: "{{ and (not .GitLab.Release) (not (get $firstnode.Languages "node").Private) }}"
{{- end }}
{{- end }}

{{- if has "sonarqube" .GitLab.Options }}

  # SonarQube template
  # https://gitlab.com/to-be-continuous/sonar
  - remote: https://gitlab.com/to-be-continuous/sonar/-/raw/6c935b3d0368ca8c8603017f3fbc5303eb117829/templates/gitlab-ci-sonar.yml # 5.3.0
    inputs:
      base-args: |
        -Dsonar.properties=sonar.properties
        -Dsonar.links.homepage=$CI_PROJECT_URL
        -Dsonar.links.ci=$CI_PROJECT_URL/-/pipelines
        -Dsonar.links.issue=$CI_PROJECT_URL/-/issues
      quality-gate-enabled: "true"
{{- end }}

{{- if has "overrides:integration" .GitLab.Options }}
  - local: .gitlab/integration.overrides.yml
{{- end }}

{{- if and $precommit (or (has "conventional-commits" .PreCommit) (has "gitflow-branches" .PreCommit)) }}

pre-commit:
  variables:
{{- if has "conventional-commits" .PreCommit }}
    GIT_DEPTH: "0"
{{- end }}
{{- if has "gitflow-branches" .PreCommit }}
    GIT_STRATEGY: clone
  before_script:
    # see https://gitlab.com/to-be-continuous/pre-commit/-/blob/main/templates/gitlab-ci-pre-commit.yml?ref_type=heads#L430
    - !reference [.pre-commit-scripts]
    - install_ca_certs "${CUSTOM_CA_CERTS:-$DEFAULT_CA_CERTS}"
    - apk add git
    - git checkout -b "$CI_COMMIT_REF_NAME"
{{- end }}
{{- end }}

{{- if $golang }}

go-govulncheck:
  allow_failure: true

{{- if gt (len .Executables.Clis) 0 }}

go-build:
  image:
    name: $GO_GORELEASER_IMAGE
    entrypoint: [""]
  needs:
    - semantic-release-info
  rules:
    # https://gitlab.com/to-be-continuous/golang/-/blob/master/templates/gitlab-ci-golang.yml?ref_type=heads#L670
    - if: '$GO_TEST_IMAGE != ""'
  script:
    - goreleaser release --clean --config .goreleaser.yml --snapshot
  artifacts:
    name: "$CI_JOB_NAME artifacts from $CI_PROJECT_NAME on $CI_COMMIT_REF_SLUG"
    paths:
      - dist
    expire_in: 1 day
{{- else if gt .Executables.Binaries 0 }}

go-build:
  rules: [when: never]
{{- end }}
{{- end }}

{{- if $node }}
{{- if gt (len $buildable) 1 }}

.node-base:
  parallel:
    matrix:
{{- range $buildable }}
      - NODE_PROJECT_DIR: {{ .Dir }}
        NODE_PUBLISH_ENABLED: "{{ and (not $.GitLab.Release) (not (get .Languages "node").Private) }}"
{{- end }}
{{- end }}

node-audit:
  allow_failure: true

node-build:
  needs:
    - semantic-release-info
{{- end }}

{{- $buildable = list }}
{{- range .ModulesWith "hugo" }}{{- if not .HasDocker }}{{- $buildable = append $buildable . }}{{- end }}{{- end }}

{{- if gt (len $buildable) 0 }}
{{- $firstnode := first $buildable }}

hugo-build:
  image:
    name: $HUGO_IMAGE
    entrypoint: [""]
  stage: build
  needs:
    - semantic-release-info
{{- if and (eq (len $buildable) 1) (ne $firstnode.Dir ".") }}
  variables:
    HUGO_PROJECT_DIR: {{ $firstnode.Dir }}
{{- end }}
{{- if gt (len $buildable) 1 }}
  parallel:
    matrix:
{{- range $buildable }}
      - HUGO_PROJECT_DIR: {{ .Dir }}
{{- end }}
{{- end }}
  rules:
    - !reference [.test-policy, rules]
  before_script:
    - git config --global --add safe.directory "$CI_PROJECT_DIR"
  script:
    - |
      [ -z "$HUGO_PROJECT_DIR" ] || cd "$HUGO_PROJECT_DIR"
    - hugo --gc --minify --destination "$CI_PROJECT_DIR/$BUILD_DIR" --logLevel "${LOG_LEVEL:-info}"
  artifacts:
    name: "$CI_JOB_NAME artifacts from $CI_PROJECT_NAME on $CI_COMMIT_REF_SLUG"
    paths:
      - $BUILD_DIR
    expire_in: 1 day
{{- end }}

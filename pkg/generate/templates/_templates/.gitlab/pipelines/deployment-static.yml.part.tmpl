{{- define "static" }}

{{- $netlify_modules := .ModulesWithDeployment "netlify" }}
{{- $netlify_multiple_modules := gt (len $netlify_modules) 1 }}

{{- $pages_modules := .ModulesWithDeployment "pages" }}
{{- $pages_multiple_modules := gt (len $pages_modules) 1 }}

{{- $node_multiple_modules := gt (len (.ModulesWith "node")) 1 }}
{{- $hugo_multiple_modules := gt (len (.ModulesWith "hugo")) 1 }}

{{- range $netlify_modules }}
netlify-deploy{{ if $netlify_multiple_modules }}-{{ .Slug }}{{ end }}:
  image: $NETLIFY_IMAGE
  stage: deploy
  environment:
    name: $ENV
    action: start
    on_stop: netlify-cleanup{{ if $netlify_multiple_modules }}-{{ .Slug }}{{ end }}
    url: $ENVIRONMENT_URL
  dependencies:
{{- if hasKey .Languages "node" }}
    - node-build{{ if $node_multiple_modules }} [{{ .Dir }}]{{ end }}
{{- end }}
{{- if hasKey .Languages "hugo" }}
    - hugo-build{{ if $hugo_multiple_modules }} [{{ .Dir }}]{{ end }}
{{- end }}
    - semantic-release-info
  rules:
    - if: '$CI_COMMIT_REF_NAME =~ $PROD_REF'
      variables:
        ARGS: --prod --message=$CI_COMMIT_REF_NAME
        ENV: netlify{{ if $netlify_multiple_modules }}/{{ .Slug }}{{ end }}
{{- if not .Config.Deployment.Auto }}
      when: manual
{{- end }}
    - if: '$CI_COMMIT_REF_NAME =~ $INTEG_REF'
      variables:
        ARGS: --alias=$BRANCH_SHA --context branch:$BRANCH_SHA --message=$CI_COMMIT_REF_NAME
        ENV: netlify/$CI_COMMIT_REF_NAME{{ if $netlify_multiple_modules }}/{{ .Slug }}{{ end }}
      when: manual
    - variables:
        ARGS: --alias=$BRANCH_SHA --context branch:$BRANCH_SHA --message=$CI_COMMIT_REF_NAME
        ENV: netlify/$CI_COMMIT_REF_NAME{{ if $netlify_multiple_modules }}/{{ .Slug }}{{ end }}
      when: manual
      allow_failure: true
  variables:
    GIT_STRATEGY: none
  before_script:
    - npm install -g netlify-cli
    - apk add --no-cache jq
  script:
    - netlify deploy --site "$NETLIFY_SITE_ID" --auth "$NETLIFY_AUTH_TOKEN" --dir "$BUILD_DIR" $ARGS --json > netlify-deploy.json
    - echo "ENVIRONMENT_URL=$(jq -r '.url // .deploy_url' netlify-deploy.json)" >> netlify.out.env
  artifacts:
    reports:
      dotenv: netlify.out.env

netlify-cleanup{{ if $netlify_multiple_modules }}-{{ .Slug }}{{ end }}:
  image: $NETLIFY_IMAGE
  stage: deploy
  dependencies: []
  environment:
    name: $ENV
    action: stop
  rules:
    - if: '$CI_COMMIT_REF_NAME =~ $PROD_REF'
      variables:
        ENV: netlify{{ if $netlify_multiple_modules }}/{{ .Slug }}{{ end }}
      when: never
    - variables:
        ENV: netlify/$CI_COMMIT_REF_NAME{{ if $netlify_multiple_modules }}/{{ .Slug }}{{ end }}
      when: manual
      allow_failure: true
  variables:
    GIT_STRATEGY: none
  before_script:
    - npm install -g netlify-cli
    - apk add --no-cache jq
  script:
    - |
      netlify api listSiteDeploys \
        --auth "$NETLIFY_AUTH_TOKEN" \
        --data "{\"site_id\": \"$NETLIFY_SITE_ID\", \"branch\": \"$BRANCH_SHA\"}" > netlify-deploys.json
    - |
      for id in $(jq -r '.[].id' netlify-deploys.json); do
        netlify api deleteSiteDeploy --auth "$NETLIFY_AUTH_TOKEN" --data "{\"site_id\": \"$NETLIFY_SITE_ID\", \"deploy_id\": \"$id\"}"
      done
{{- end }}

{{- range $pages_modules }}
pages{{ if $pages_multiple_modules }}-{{ .Slug }}{{ end }}:
  image: $PAGES_IMAGE
  stage: deploy
  environment:
    name: $ENV
    action: start
    url: $CI_PAGES_URL
  variables:
    ENV: pages{{ if $pages_multiple_modules }}/{{ .Slug }}{{ end }}
    GIT_STRATEGY: none
  dependencies:
{{- if hasKey .Languages "node" }}
    - node-build{{ if $node_multiple_modules }} [{{ .Dir }}]{{ end }}
{{- end }}
{{- if hasKey .Languages "hugo" }}
    - hugo-build{{ if $hugo_multiple_modules }} [{{ .Dir }}]{{ end }}
{{- end }}
  rules:
    - if: $CI_COMMIT_REF_NAME == $CI_DEFAULT_BRANCH
{{- if not .Config.Deployment.Auto }}
      when: manual
{{- end }}
  script:
    - |
      if [ "$BUILD_DIR" != "public" ]; then
        mkdir -p public
        mv "$BUILD_DIR"/* public
      fi
  artifacts:
    name: "$CI_JOB_NAME artifacts from $CI_PROJECT_NAME on $CI_COMMIT_REF_SLUG"
    paths:
      - public
    expire_in: 1 day
{{- end }}
{{- end }}

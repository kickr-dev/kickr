{{- define "static" }}

{{- $hugo := hasKey .Languages "hugo" }}
{{- $node := hasKey .Languages "node" }}

{{- $websiteDirectory := .Website.Directory | default "." }}

{{- $needs := "" }}
{{- if $node }}{{- range (get .Languages "node") }}{{- if eq .Directory $websiteDirectory }}{{- $needs = "node-build" }}{{- end }}{{- end }}{{- end }}
{{- if $hugo }}{{- range (get .Languages "hugo") }}{{- if eq .Directory $websiteDirectory }}{{- $needs = "hugo-build" }}{{- end }}{{- end }}{{- end }}

{{- $matrix := or (and (eq $needs "node-build") (gt (len (get .Languages "node")) 1)) (and (eq $needs "hugo-build") (gt (len (get .Languages "hugo")) 1)) }}

{{- if eq .Website.Hosting "netlify" }}
netlify-deploy:
  image: $NETLIFY_IMAGE
  stage: deploy
  environment:
    name: $ENV
    action: start
    on_stop: netlify-cleanup
    url: $ENVIRONMENT_URL
  dependencies:
    - {{ not $matrix | ternary $needs (printf "%s: [%s]" $needs $websiteDirectory | quote) }}
    - semantic-release-info
  rules:
    - if: $CI_COMMIT_REF_NAME == $CI_DEFAULT_BRANCH
      variables:
        ARGS: --prod --message=$CI_COMMIT_REF_NAME
        ENV: production
{{- if not .Website.Auto }}
      when: manual
{{- end }}
    - variables:
        ARGS: --alias=$BRANCH_SHA --context branch:$BRANCH_SHA --message=$CI_COMMIT_REF_NAME
        ENV: review/$CI_COMMIT_REF_NAME
      when: manual
      allow_failure: true
  before_script:
    - npm install -g netlify-cli
    - apk add --no-cache jq
  script:
    - netlify deploy --site "$NETLIFY_SITE_ID" --auth "$NETLIFY_AUTH_TOKEN" --dir "$BUILD_DIR" $ARGS --json > netlify-deploy.json
    - echo "ENVIRONMENT_URL=$(jq -r '.url // .deploy_url' netlify-deploy.json)" >> netlify.out.env
  artifacts:
    reports:
      dotenv: netlify.out.env

netlify-cleanup:
  image: $NETLIFY_IMAGE
  stage: deploy
  dependencies: []
  environment:
    name: $ENV
    action: stop
  rules:
    - if: $CI_COMMIT_REF_NAME == $CI_DEFAULT_BRANCH
      variables:
        ENV: production
      when: never
    - variables:
        ENV: review/$CI_COMMIT_REF_NAME
      when: manual
      allow_failure: true
  variables:
    GIT_STRATEGY: none
  before_script:
    - npm install -g netlify-cli
    - apk add --no-cache jq
  script:
    - |
      netlify api listSiteDeploys \
        --auth "$NETLIFY_AUTH_TOKEN" \
        --data "{\"site_id\": \"$NETLIFY_SITE_ID\", \"branch\": \"$BRANCH_SHA\"}" > netlify-deploys.json
    - |
      for id in $(jq -r '.[].id' netlify-deploys.json); do
        netlify api deleteSiteDeploy --auth "$NETLIFY_AUTH_TOKEN" --data "{\"site_id\": \"$NETLIFY_SITE_ID\", \"deploy_id\": \"$id\"}"
      done
{{- end }}

{{- if eq .Website.Hosting "pages" }}
pages:
  image: $PAGES_IMAGE
  stage: deploy
  environment:
    name: $ENV
    action: start
    url: $CI_PAGES_URL
  variables:
    ENV: production
  dependencies:
    - {{ not $matrix | ternary $needs (printf "%s: [%s]" $needs $websiteDirectory | quote) }}
  rules:
    - if: $CI_COMMIT_REF_NAME == $CI_DEFAULT_BRANCH
{{- if not .Website.Auto }}
      when: manual
{{- end }}
  script:
    - |
      if [ "$BUILD_DIR" != "public" ]; then
        mkdir -p public
        mv "$BUILD_DIR"/* public
      fi
  artifacts:
    name: "$CI_JOB_NAME artifacts from $CI_PROJECT_NAME on $CI_COMMIT_REF_SLUG"
    paths:
      - public
    expire_in: 1 day
{{- end }}
{{- end }}

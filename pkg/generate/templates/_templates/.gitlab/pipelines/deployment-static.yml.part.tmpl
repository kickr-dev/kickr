{{- define "static" }}

{{- $netlify_modules := .ModulesWithDeployment "netlify" }}
{{- $pages_modules := .ModulesWithDeployment "pages" }}

{{- $node_modules := .ModulesWith "node" }}
{{- $hugo_modules := .ModulesWith "hugo" }}

{{- range $netlify_modules }}

{{- $suffix := gt (len $netlify_modules) 1 | ternary .Slug "" }}
netlify-deploy{{ with $suffix }}-{{ . }}{{ end }}:
  image: $NETLIFY_IMAGE
  stage: deploy
  environment:
    name: $ENV
    action: start
    on_stop: netlify-cleanup{{ with $suffix }}-{{ . }}{{ end }}
    url: $ENVIRONMENT_URL
  dependencies:
{{- if hasKey .Languages "node" }}
    - node-build{{ if gt (len $node_modules) 1 }} [{{ .Dir }}]{{ end }}
{{- end }}
{{- if hasKey .Languages "hugo" }}
    - hugo-build{{ if gt (len $hugo_modules) 1 }} [{{ .Dir }}]{{ end }}
{{- end }}
    - semantic-release-info
  rules:
    - if: '$CI_COMMIT_REF_NAME =~ $PROD_REF'
      variables:
        ARGS: --prod --message=$CI_COMMIT_REF_NAME
        ENV: netlify{{ with $suffix }}/{{ . }}{{ end }}
{{- if not .Config.Deployment.Auto }}
      when: manual
{{- end }}
    - if: '$CI_COMMIT_REF_NAME =~ $INTEG_REF'
      variables:
        ARGS: --alias=$BRANCH_SHA --context branch:$BRANCH_SHA --message=$CI_COMMIT_REF_NAME
        ENV: netlify/$CI_COMMIT_REF_NAME{{ with $suffix }}/{{ . }}{{ end }}
      when: manual
    - variables:
        ARGS: --alias=$BRANCH_SHA --context branch:$BRANCH_SHA --message=$CI_COMMIT_REF_NAME
        ENV: netlify/$CI_COMMIT_REF_NAME{{ with $suffix }}/{{ . }}{{ end }}
      when: manual
      allow_failure: true
  variables:
    GIT_STRATEGY: none
  before_script:
    - npm install -g netlify-cli
    - apk add --no-cache jq
  script:
    - netlify deploy --site "$NETLIFY_SITE_ID" --auth "$NETLIFY_AUTH_TOKEN" --dir "$BUILD_DIR" $ARGS --json > netlify-deploy.json
    - echo "ENVIRONMENT_URL=$(jq -r '.url // .deploy_url' netlify-deploy.json)" >> netlify.out.env
  artifacts:
    reports:
      dotenv: netlify.out.env

netlify-cleanup{{ with $suffix }}-{{ . }}{{ end }}:
  image: $NETLIFY_IMAGE
  stage: deploy
  dependencies: []
  environment:
    name: $ENV
    action: stop
  rules:
    - if: '$CI_COMMIT_REF_NAME =~ $PROD_REF'
      variables:
        ENV: netlify{{ with $suffix }}/{{ . }}{{ end }}
      when: never
    - variables:
        ENV: netlify/$CI_COMMIT_REF_NAME{{ with $suffix }}/{{ . }}{{ end }}
      when: manual
      allow_failure: true
  variables:
    GIT_STRATEGY: none
  before_script:
    - npm install -g netlify-cli
    - apk add --no-cache jq
  script:
    - |
      netlify api listSiteDeploys \
        --auth "$NETLIFY_AUTH_TOKEN" \
        --data "{\"site_id\": \"$NETLIFY_SITE_ID\", \"branch\": \"$BRANCH_SHA\"}" > netlify-deploys.json
    - |
      for id in $(jq -r '.[].id' netlify-deploys.json); do
        netlify api deleteSiteDeploy --auth "$NETLIFY_AUTH_TOKEN" --data "{\"site_id\": \"$NETLIFY_SITE_ID\", \"deploy_id\": \"$id\"}"
      done
{{- end }}

{{- if gt (len $pages_modules) 0 }}
{{- $page := first $pages_modules }}
pages:
  image: $PAGES_IMAGE
  stage: deploy
  environment:
    name: $ENV
    action: start
    url: $CI_PAGES_URL
  variables:
    ENV: pages
    GIT_STRATEGY: none
  dependencies:
{{- if hasKey $page.Languages "node" }}
    - node-build{{ if gt (len $node_modules) 1 }} [{{ $page.Dir }}]{{ end }}
{{- end }}
{{- if hasKey $page.Languages "hugo" }}
    - hugo-build{{ if gt (len $hugo_modules) 1 }} [{{ $page.Dir }}]{{ end }}
{{- end }}
  rules:
    - if: $CI_COMMIT_REF_NAME == $CI_DEFAULT_BRANCH
{{- if not $page.Config.Deployment.Auto }}
      when: manual
{{- end }}
  script:
    - |
      if [ "$BUILD_DIR" != "public" ]; then
        mkdir -p public
        mv "$BUILD_DIR"/* public
      fi
  artifacts:
    name: "$CI_JOB_NAME artifacts from $CI_PROJECT_NAME on $CI_COMMIT_REF_SLUG"
    paths:
      - public
    expire_in: 1 day
{{- end }}
{{- end }}

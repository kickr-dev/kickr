{{- define "static" }}

{{- $netlify_modules := .ModulesWithDeployment "netlify" }}
{{- $netlify_multiple_modules := gt (len $netlify_modules) 1 }}

{{- $pages_modules := .ModulesWithDeployment "pages" }}
{{- $pages_multiple_modules := gt (len $pages_modules) 1 }}

{{- $node_multiple_modules := gt (len (.ModulesWith "node")) 1 }}
{{- $hugo_multiple_modules := gt (len (.ModulesWith "hugo")) 1 }}

{{- if gt (len $netlify_modules) 0 }}

.netlify-deploy:
  image: $NETLIFY_IMAGE
  stage: deploy
  before_script:
    - npm install -g netlify-cli
    - apk add --no-cache jq
  script:
    # netlify-cli reads netlify.toml from the current directory
    - cd "$NETLIFY_PROJECT_DIR"
    - environment_namespace=$(echo "$NETLIFY_ENVIRONMENT_NAMESPACE" | tr -d '[:punct:]' | tr '[:upper:]' '[:lower:]')
    - export $environment_namespace
    - netlify deploy --site "$NETLIFY_SITE_ID" --auth "$NETLIFY_AUTH_TOKEN" --dir "$BUILD_DIR" $ARGS --json > netlify-deploy.json
    - dotenvfile="netlify.env${environment_namespace:+.${environment_namespace}}"
    - echo "ENVIRONMENT_URL=$(jq -r '.url // .deploy_url' netlify-deploy.json)" >> "$CI_PROJECT_DIR/$dotenvfile"
  artifacts:
    reports:
      dotenv: $CI_PROJECT_DIR/netlify.env*

.netlify-cleanup:
  image: $NETLIFY_IMAGE
  stage: deploy
  dependencies: []
  variables:
    GIT_STRATEGY: none
  before_script:
    - npm install -g netlify-cli
    - apk add --no-cache jq
  script:
    - branch_sha="$(echo "$CI_COMMIT_REF_NAME" | sha256sum | cut -c -8)"
    - |
      netlify api listSiteDeploys \
        --auth "$NETLIFY_AUTH_TOKEN" \
        --data "{\"site_id\": \"$NETLIFY_SITE_ID\", \"branch\": \"$branch_sha\"}" > netlify-deploys.json
    - |
      for id in $(jq -r '.[].id' netlify-deploys.json); do
        netlify api deleteSiteDeploy --auth "$NETLIFY_AUTH_TOKEN" --data "{\"site_id\": \"$NETLIFY_SITE_ID\", \"deploy_id\": \"$id\"}"
      done
{{- end }}

{{- range $netlify_modules }}

netlify-deploy-review{{ if $netlify_multiple_modules }}-{{ .Slug }}{{ end }}:
  extends: .netlify-deploy
  environment:
    name: review${NETLIFY_ENVIRONMENT_NAMESPACE}/${CI_COMMIT_REF_NAME}
    action: start
    on_stop: netlify-cleanup-review{{ if $netlify_multiple_modules }}-{{ .Slug }}{{ end }}
    url: $ENVIRONMENT_URL
  dependencies:
{{- if hasKey .Languages "node" }}
    - {{ if not $node_multiple_modules }}node-build{{ else }}"node-build: [{{ .Dir }}]"{{ end }}
{{- end }}
{{- if hasKey .Languages "hugo" }}
    - {{ if not $hugo_multiple_modules }}hugo-build{{ else }}"hugo-build: [{{ .Dir }}]"{{ end }}
{{- end }}
    - semantic-release-info
  rules:
    - if: '$CI_COMMIT_REF_NAME =~ $PROD_REF'
      when: never
    - when: manual
      allow_failure: true
  variables:
    ARGS: --alias=$BRANCH_SHA --context branch:$BRANCH_SHA --message=$CI_COMMIT_REF_NAME
{{- if $netlify_multiple_modules }}
    NETLIFY_ENVIRONMENT_NAMESPACE: /{{ .Slug }}
{{- end }}
    NETLIFY_PROJECT_DIR: {{ .Dir }}

netlify-cleanup-review{{ if $netlify_multiple_modules }}-{{ .Slug }}{{ end }}:
  extends: .netlify-cleanup
  environment:
    name: review${NETLIFY_ENVIRONMENT_NAMESPACE}/${CI_COMMIT_REF_NAME}
    action: stop
  rules:
    - if: '$CI_COMMIT_REF_NAME =~ $PROD_REF'
      when: never
    - when: manual
      allow_failure: true

netlify-deploy-production{{ if $netlify_multiple_modules }}-{{ .Slug }}{{ end }}:
  extends: .netlify-deploy
  environment:
    name: production${NETLIFY_ENVIRONMENT_NAMESPACE}
    action: start
    url: $ENVIRONMENT_URL
  dependencies:
{{- if hasKey .Languages "node" }}
    - {{ if not $node_multiple_modules }}node-build{{ else }}"node-build: [{{ .Dir }}]"{{ end }}
{{- end }}
{{- if hasKey .Languages "hugo" }}
    - {{ if not $hugo_multiple_modules }}hugo-build{{ else }}"hugo-build: [{{ .Dir }}]"{{ end }}
{{- end }}
    - semantic-release-info
  rules:
    - if: '$CI_COMMIT_REF_NAME !~ $PROD_REF'
      when: never
    - when: {{ .Config.Deployment.Auto | ternary "on_success" "manual" }}
  variables:
    ARGS: --prod --message=$CI_COMMIT_REF_NAME
{{- if $netlify_multiple_modules }}
    NETLIFY_ENVIRONMENT_NAMESPACE: /{{ .Slug }}
{{- end }}
    NETLIFY_PROJECT_DIR: {{ .Dir }}
{{- end }}

{{- if gt (len $pages_modules) 0 }}

.pages:
  image: $PAGES_IMAGE
  stage: deploy
  environment:
    name: pages${PAGES_ENVIRONMENT_NAMESPACE}
    action: start
    url: $CI_PAGES_URL
  variables:
    GIT_STRATEGY: none
  rules:
    - if: $CI_COMMIT_REF_NAME != $CI_DEFAULT_BRANCH
      when: never
  script:
    - cd "$PAGES_PROJECT_DIR"
      if [ "$BUILD_DIR" != "public" ]; then
        mkdir -p public
        mv "$BUILD_DIR"/* public
      fi
  artifacts:
    name: "$CI_JOB_NAME artifacts from $CI_PROJECT_NAME on $CI_COMMIT_REF_SLUG"
    paths:
      - public
    expire_in: 1 day
{{- end }}

{{- range $pages_modules }}

pages{{ if $pages_multiple_modules }}-{{ .Slug }}{{ end }}:
  extends: .pages
{{- if or $pages_multiple_modules (ne .Dir ".") }}
  variables:
{{- if $pages_multiple_modules }}
    PAGES_ENVIRONMENT_NAMESPACE: /{{ .Slug }}
{{- end }}
    PAGES_PROJECT_DIR: {{ .Dir }}
{{- end }}
  dependencies:
{{- if hasKey .Languages "node" }}
    - {{ if not $node_multiple_modules }}node-build{{ else }}"node-build: [{{ .Dir }}]"{{ end }}
{{- end }}
{{- if hasKey .Languages "hugo" }}
    - {{ if not $hugo_multiple_modules }}hugo-build{{ else }}"hugo-build: [{{ .Dir }}]"{{ end }}
{{- end }}
{{- if not .Config.Deployment.Auto }}
  when: manual
{{- end }}
{{- end }}
{{- end }}

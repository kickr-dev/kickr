{{- if not (or .Config.IsHelmLibrary (has "workload" .Config.Helm.Exclude)) -}}
{{- $helm_modules := .ModulesWith "helm" -}}
{{- $chart := get (first $helm_modules).Languages "helm" -}}
# Code generated by kickr; DO NOT EDIT.
# yaml-language-server: $schema=https://gitlab.com/kickr-dev/workload/-/raw/main/chart/values.schema.json
# Override in values.default.yaml or values.<env>.yaml, reference: https://gitlab.com/kickr-dev/workload/-/blob/main/chart/values.yaml

imagePullSecrets: []

appVersion: ""
nameOverride: ""
fullnameOverride: ""

#############################################
#                all workers                #
#############################################
{{- with $chart.workers }}
workers:
{{- range $name, $config := . }}
  {{ $name }}:
    kind: Deployment
    paused: true
    restartPolicy: Always
    image:
      {{- with $chart.docker.registry }}
      registry: {{ . }}
      {{- end }}
      repository: {{ $config.image.repository }}
    env:
      BINARY_NAME:
        fieldRef:
          fieldPath: metadata.labels['app.kubernetes.io/component']
    ports:
      http: {{ $chart.docker.port | default 3000 }}
{{- end }}
{{- else }}
workers: {}
{{- end }}

#############################################
#                 all jobs                  #
#############################################
{{- with $chart.jobs }}
jobs:
{{- range $name, $config := . }}
  {{ $name }}:
    suspend: true
    restartPolicy: OnFailure
    image:
      {{- with $chart.docker.registry }}
      registry: {{ . }}
      {{- end }}
      repository: {{ $config.image.repository }}
    env:
      BINARY_NAME:
        fieldRef:
          fieldPath: metadata.labels['app.kubernetes.io/component']
{{- end }}
{{- else }}
jobs: {}
{{- end }}

#############################################
#               all cronjobs                #
#############################################
{{- with $chart.crons }}
crons:
{{- range $name, $config := . }}
  {{ $name }}:
    schedule: "0 0 */1 * *"
    suspend: true
    restartPolicy: OnFailure
    image:
      {{- with $chart.docker.registry }}
      registry: {{ . }}
      {{- end }}
      repository: {{ $config.image.repository }}
    env:
      BINARY_NAME:
        fieldRef:
          fieldPath: metadata.labels['app.kubernetes.io/component']
{{- end }}
{{- else }}
crons: {}
{{- end }}
{{ end -}}

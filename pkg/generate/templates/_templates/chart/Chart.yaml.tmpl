{{- $helm_modules := .ModulesWith "helm" }}
{{- $chart := get (first $helm_modules).Languages "helm" -}}

apiVersion: v2
name: {{ $chart.projectName }}
# BEGIN_KICKR_DESCRIPTION
description: {{ $chart.description | default "A Helm chart for Kubernetes" | toYaml }}
# END_KICKR_DESCRIPTION

# Chart type, either 'application' or 'library'.
#   - An application chart is packaged into a versioned archive and deployed.
#   - A library chart only shares helpers with the application charts depending on it, so it can't be deployed.
type: {{ .Config.IsHelmLibrary | ternary "library" "application" }}

# Chart version, following Semantic Versioning (https://semver.org/).
# Bump it on any change to the chart, its templates or its app version.
#
# When using kickr generated CI/CD, leave the placeholder as is since it's set to the release version when packaging.
version: 0.0.0
{{- if not .Config.IsHelmLibrary }}

# Version of the deployed application, matching the version the application itself uses.
# Bump it on any application change. Semantic Versioning isn't required, so keep it quoted.
#
# When using kickr generated CI/CD, leave the placeholder as is since it's set to the release version when packaging.
appVersion: "0.0.0"

dependencies:{{ if has "workload" .Config.Helm.Exclude }} []{{ else }}
  # BEGIN_KICKR_WORKLOAD
  - name: workload
    version: 0.3.0
    repository: oci://registry.gitlab.com/kickr-dev
  # END_KICKR_WORKLOAD
{{- end }}
{{- end }}

# BEGIN_KICKR_MAINTAINERS
{{- with $chart.maintainers }}
maintainers:
  {{- toYaml . | nindent 2 }}
{{- end }}
# END_KICKR_MAINTAINERS

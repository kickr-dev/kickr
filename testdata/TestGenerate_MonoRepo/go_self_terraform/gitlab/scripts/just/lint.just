# Code generated by kickr; DO NOT EDIT.

# lint go files.
go-lint *ARGS:
  @golangci-lint run --config=${GOCI_LINT_PATH:-.golangci.yml} --timeout=300s --allow-parallel-runners \
    --output.text.path=stdout {{ ARGS }} || \
    echo "golangci-lint failed, running 'just go-lint-fix' may fix some issues"

# lint and fix go files.
go-lint-fix:
  @just go-lint --fix

# format terraform files.
fmt:
  @tofu fmt -diff -recursive

# lint terraform files.
tflint *ARGS:
  @tflint --config "${TFLINT_PATH:-.tflint.hcl}" --recursive --format compact {{ ARGS }} || \
    echo "tflint failed, running 'just tflint-fix' may fix some issues"

# lint and fix terraform files.
tflint-fix:
  @just tflint --fix

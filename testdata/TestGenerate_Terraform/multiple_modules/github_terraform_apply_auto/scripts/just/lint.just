# Code generated by kickr; DO NOT EDIT.

# format terraform files.
fmt:
  @terraform fmt -diff -recursive

# lint terraform files.
lint *ARGS:
  @tflint --config "${TFLINT_PATH:-.tflint.hcl}" --recursive --format compact {{ ARGS }} || \
    echo "tflint failed, running 'just lint-fix' may fix some issues"

# lint and fix terraform files.
lint-fix:
  @just lint --fix
